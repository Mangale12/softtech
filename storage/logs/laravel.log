    #<span class=sf-dump-protected title=\"Protected property\">original</span>: <span class=sf-dump-note>array:43</span> [<samp data-depth=3 class=sf-dump-compact>
      \"<span class=sf-dump-key>id</span>\" => <span class=sf-dump-num>33</span>
