      \"<span class=sf-dump-key>description</span>\" => \"<span class=sf-dump-str title=\"1107 characters\">&lt;h5 class=&quot;mb-lg-4&quot; style=&quot;box-sizing: border-box; line-height: 1.2; color: rgb(33, 37, 41); font-family: Roboto, sans-serif;&quot;&gt;TAAN members specialise in offering you an unrivalled collection of financially protected, quality adventure holidays to every corner of the Nepal.&lt;/h5&gt;&lt;p style=&quot;box-sizing: border-box; margin-bottom: 0px; font-size: 18px; padding-top: 0px; padding-bottom: 0px; line-height: 29px; color: rgb(33, 37, 41); font-family: Roboto, sans-serif;&quot;&gt;Trekking Agencies&#039; Association of Nepal (TAAN) is an umbrella association of trekking agencies in the country.&lt;/p&gt;&lt;p&gt;&lt;br style=&quot;box-sizing: border-box; color: rgb(33, 37, 41); font-family: Roboto, sans-serif; font-size: 16px;&quot;&gt;&lt;/p&gt;&lt;p style=&quot;box-sizing: border-box; margin-bottom: 0px; font-size: 18px; padding-top: 0px; padding-bottom: 0px; line-height: 29px; color: rgb(33, 37, 41); font-family: Roboto, sans-serif;&quot;&gt;It was established in 1979 by a handful of trekking agency operators who felt it was time to devise sound business principles as well as regulate the sector which was growing by leaps and bounds with every passing year.&lt;/p&gt;</span>\"
